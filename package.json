{
  "name": "foms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Farm Operations Management System",
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "build:css": "tailwindcss -i ./client/styles/input.css -o ./client/styles.css --minify",
    "build": "npm run build:css",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
