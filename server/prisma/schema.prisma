generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  AGRONOMIST
  WORKER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JournalIncidentStatus {
  OPEN
  RESOLVED
}

enum JournalIncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum InventoryCategory {
  SEED
  FERTILIZER
  CHEMICAL
  FEED
  VACCINE
  SUPPLEMENT
  ASSET
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DocumentCategory {
  SOIL_REPORT
  WATER_ANALYSIS
  PATHOLOGY_REPORT
  FARM_LICENSE
  PURCHASE_RECEIPT
  AGRONOMIST_REPORT
  FARM_PHOTO
  OTHER
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  memberships Membership[]
  farms       Farm[]
  blocks      Block[]
  cropCycles  CropCycle[]
  livestock   Livestock[]
  tasks       Task[]
  journal     JournalEntry[]
  expenses    Expense[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  buyers      Buyer[]
  sales       Sale[]
  documents   Document[]
  payments    Payment[]
  audits      AuditLog[]
  cropTypes   CropType[]
  notifications Notification[]
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  email          String       @unique
  username       String       @unique
  isPlatformAdmin Boolean     @default(false)
  sessionVersion Int          @default(0)
  mustChangePassword Boolean  @default(false)
  temporaryPasswordHash String?
  temporaryPasswordExpiresAt DateTime?
  passwordHash   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  memberships    Membership[]
  refreshTokens  RefreshToken[]
  setupToken     AccountSetupToken?
  createdFarms   Farm[]       @relation("FarmCreator")
  createdBlocks  Block[]      @relation("BlockCreator")
  createdCrops   CropCycle[]  @relation("CropCreator")
  createdAnimals Livestock[]  @relation("LivestockCreator")
  assignedTasks  Task[]       @relation("TaskAssignee")
  createdTasks   Task[]       @relation("TaskCreator")
  journalEntries JournalEntry[] @relation("JournalAuthor")
  journalFollowUps JournalFollowUp[]
  createdExpenses Expense[]   @relation("ExpenseCreator")
  createdInventoryItems InventoryItem[] @relation("InventoryItemCreator")
  createdStockMovements StockMovement[] @relation("StockMovementCreator")
  createdBuyers Buyer[] @relation("BuyerCreator")
  createdSales Sale[] @relation("SaleCreator")
  receivedPayments Payment[] @relation("PaymentRecorder")
  uploadedDocuments Document[] @relation("DocumentUploader")
  auditEntries   AuditLog[]
  notifications Notification[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role         @default(WORKER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  organizationId String? @db.Uuid
  sessionVersion Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AccountSetupToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  location       String?
  latitude       Float?
  longitude      Float?
  acreage        Float?
  description    String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User?        @relation("FarmCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  blocks         Block[]
  cropCycles     CropCycle[]
  livestock      Livestock[]
  tasks          Task[]
  journal        JournalEntry[]
  expenses       Expense[]
  inventoryItems InventoryItem[]
  buyers         Buyer[]
  sales          Sale[]
  documents      Document[]

  @@index([organizationId, deletedAt])
}

model Block {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String       @db.Uuid
  name           String
  acreage        Float?
  latitude       Float?
  longitude      Float?
  currentUse     String?
  soilType       String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  creator        User?        @relation("BlockCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  cropCycles     CropCycle[]
  journal        JournalEntry[]

  @@index([organizationId, farmId, deletedAt])
}

model CropCycle {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String       @db.Uuid
  blockId        String?      @db.Uuid
  cropName       String
  variety        String?
  status         String       @default("PLANNED")
  acreage        Float?
  expectedYield  Float?
  nurseryDate    DateTime?
  plantingDate   DateTime?
  expectedHarvest DateTime?
  notes          String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  block          Block?       @relation(fields: [blockId], references: [id], onDelete: SetNull)
  creator        User?        @relation("CropCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  cropTypeId     String?      @db.Uuid
  requiresNursery Boolean    @default(false)
  nurseryDays    Int?
  transplantDate DateTime?
  yieldingDays   Int?
  journalEntries JournalEntry[]
  stages         CropStage[]
  activities     CropActivity[]
  cropType       CropType?   @relation(fields: [cropTypeId], references: [id], onDelete: SetNull)

  @@index([organizationId, farmId, deletedAt])
}

model CropType {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  requiresNursery Boolean     @default(false)
  nurseryDays    Int?
  maturityDays   Int?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycles         CropCycle[]

  @@unique([organizationId, name])
}

model CropStage {
  id        String    @id @default(uuid()) @db.Uuid
  cropId    String    @db.Uuid
  stage     String
  occurredAt DateTime @default(now())
  notes     String?
  recordedBy String?  @db.Uuid
  createdAt DateTime  @default(now())
  crop      CropCycle @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId, occurredAt])
}

model CropActivity {
  id         String    @id @default(uuid()) @db.Uuid
  cropId     String    @db.Uuid
  type       String
  customActivity String?
  occurredAt DateTime
  quantity   Float
  unit       String
  customUnit String?
  product    String?
  notes      String?
  recordedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  crop       CropCycle @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([cropId, occurredAt])
}

model Livestock {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String       @db.Uuid
  species        String
  identifier     String?
  breed          String?
  quantity       Int          @default(1)
  trackingMode   String       @default("INDIVIDUAL")
  initialQuantity Int         @default(1)
  birthDate      DateTime?
  weightKg       Float?
  healthStatus   String       @default("HEALTHY")
  lastVaccinated DateTime?
  healthObservedAt DateTime?
  weightObservedAt DateTime?
  notes          String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  creator        User?        @relation("LivestockCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]
  events         LivestockEvent[]

  @@index([organizationId, farmId, species, deletedAt])
}

model LivestockEvent {
  id             String    @id @default(uuid()) @db.Uuid
  livestockId    String    @db.Uuid
  type           String
  occurredAt     DateTime
  title          String?
  quantity       Int?
  weightKg       Float?
  feedKg         Float?
  healthStatus   String?
  nextDueAt      DateTime?
  notes          String?
  recordedBy     String    @db.Uuid
  createdAt      DateTime  @default(now())
  livestock      Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  purchaseExpense Expense?
  saleInvoice    Sale?

  @@index([livestockId, occurredAt, id])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String?      @db.Uuid
  title          String
  description    String?
  category       String?
  status         TaskStatus   @default(PENDING)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?
  assignedTo     String?      @db.Uuid
  createdBy      String?      @db.Uuid
  evidenceUrl    String?
  completedAt    DateTime?
  evidenceRequired Boolean    @default(false)
  submissionNotes String?
  approvedAt     DateTime?
  approvedBy     String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator        User?        @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  evidence       TaskEvidence[]
  events         TaskEvent[]
  notifications Notification[]

  @@index([organizationId, status, dueDate, deletedAt])
}

model TaskEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @db.Uuid
  storageName    String
  mimeType       String
  originalName   String
  uploadedBy     String   @db.Uuid
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, deletedAt, createdAt])
}

model TaskEvent {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @db.Uuid
  action         String
  fromStatus     TaskStatus?
  toStatus       TaskStatus?
  notes          String?
  recordedBy     String   @db.Uuid
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt, id])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  taskId         String?      @db.Uuid
  inventoryItemId String?     @db.Uuid
  type           String
  message        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
}

model JournalEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String?      @db.Uuid
  blockId        String?      @db.Uuid
  title          String
  category       String       @default("OBSERVATION")
  body           String
  weather        String?
  incident       String?
  incidentStatus JournalIncidentStatus?
  incidentSeverity JournalIncidentSeverity?
  incidentUpdatedAt DateTime?
  cost           Float        @default(0)
  photoUrl       String?
  cropId         String?      @db.Uuid
  livestockId    String?      @db.Uuid
  subjectType    String       @default("GENERAL")
  photoStorageName String?
  photoMimeType  String?
  photoOriginalName String?
  observedAt     DateTime     @default(now())
  authorId       String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  block          Block?       @relation(fields: [blockId], references: [id], onDelete: SetNull)
  author         User?        @relation("JournalAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  crop           CropCycle?   @relation(fields: [cropId], references: [id], onDelete: SetNull)
  livestock      Livestock?   @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  followUps      JournalFollowUp[]

  @@index([organizationId, observedAt, deletedAt])
}

model JournalFollowUp {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  journalEntryId String @db.Uuid
  requestId      String @db.Uuid
  notes          String
  observedAt     DateTime
  incidentStatus JournalIncidentStatus
  incidentSeverity JournalIncidentSeverity?
  recordedBy     String? @db.Uuid
  createdAt      DateTime @default(now())
  journal        JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  author         User? @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([journalEntryId, requestId])
  @@index([organizationId, journalEntryId, observedAt])
}

model Expense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String?      @db.Uuid
  description    String
  category       String
  supplier       String?
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("KES")
  paymentMethod  String?
  expenseDate    DateTime     @default(now())
  notes          String?
  approvedAt     DateTime?
  approvedBy     String?      @db.Uuid
  requestId      String?      @db.Uuid
  requestHash    String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  livestockEventId String?    @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  creator        User?        @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  attachments    ExpenseAttachment[]
  livestockEvent LivestockEvent? @relation(fields: [livestockEventId], references: [id], onDelete: SetNull)

  @@unique([organizationId, requestId])
  @@index([organizationId, expenseDate, deletedAt])
}

model ExpenseAttachment {
  id             String @id @default(uuid()) @db.Uuid
  expenseId      String @db.Uuid
  organizationId String @db.Uuid
  originalName   String
  storageName    String
  mimeType       String
  sizeBytes      Int
  uploadedBy     String @db.Uuid
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  expense        Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, deletedAt])
}

model InventoryItem {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  farmId         String?           @db.Uuid
  name           String
  sku            String?
  category       InventoryCategory
  unit           String
  quantity       Decimal           @default(0) @db.Decimal(15, 3)
  reorderLevel   Decimal           @default(0) @db.Decimal(15, 3)
  trackingMode   String            @default("BATCH")
  assetCondition String?
  conditionObservedAt DateTime?
  serialNumber   String?
  nextMaintenanceDate DateTime?
  lowStockAlertActive Boolean      @default(false)
  creationRequestId String?        @db.Uuid
  notes          String?
  createdBy      String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?             @relation(fields: [farmId], references: [id], onDelete: SetNull)
  creator        User?             @relation("InventoryItemCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  movements      StockMovement[]
  assetEvents    InventoryAssetEvent[]
  notifications Notification[]

  @@unique([organizationId, sku])
  @@unique([organizationId, creationRequestId])
  @@index([organizationId, category, deletedAt])
  @@index([organizationId, quantity, reorderLevel])
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  itemId         String            @db.Uuid
  type           StockMovementType
  quantity       Decimal           @db.Decimal(15, 3)
  balanceAfter   Decimal?          @db.Decimal(15, 3)
  requestId      String?           @db.Uuid
  occurredAt     DateTime          @default(now())
  unitCost       Decimal?          @db.Decimal(12, 2)
  reference      String?
  notes          String?
  createdBy      String?           @db.Uuid
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creator        User?             @relation("StockMovementCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId, createdAt])
  @@unique([itemId, requestId])
}

model InventoryAssetEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  itemId         String @db.Uuid
  requestId      String @db.Uuid
  type           String
  condition      String
  notes          String
  cost           Decimal? @db.Decimal(12, 2)
  observedAt     DateTime
  nextMaintenanceDate DateTime?
  recordedBy     String @db.Uuid
  createdAt      DateTime @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, requestId])
  @@index([organizationId, itemId, observedAt])
}

model Buyer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String?      @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  creator        User?        @relation("BuyerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sales          Sale[]

  @@index([organizationId, name, deletedAt])
}

model Sale {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  farmId         String?      @db.Uuid
  buyerId        String?      @db.Uuid
  invoiceNumber  String
  product        String
  quantity       Float
  unit           String
  unitPrice      Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  currency       String       @default("KES")
  soldAt         DateTime     @default(now())
  dueDate        DateTime?
  notes          String?
  requestId      String?      @db.Uuid
  requestHash    String?
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  livestockEventId String?    @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  buyer          Buyer?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  creator        User?        @relation("SaleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  payments       Payment[]
  livestockEvent LivestockEvent? @relation(fields: [livestockEventId], references: [id], onDelete: SetNull)

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, requestId])
  @@index([organizationId, soldAt, deletedAt])
  @@index([organizationId, buyerId])
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  saleId         String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  method         String
  reference      String?
  requestId      String?      @db.Uuid
  requestHash    String?
  receivedAt     DateTime     @default(now())
  recordedBy     String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recorder       User?        @relation("PaymentRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, saleId, receivedAt])
  @@unique([organizationId, requestId])
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  farmId         String?          @db.Uuid
  category       DocumentCategory
  originalName   String
  storageName    String           @unique
  mimeType       String
  sizeBytes      Int
  description    String?
  uploadedBy     String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm           Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  uploader       User?            @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, category, deletedAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
